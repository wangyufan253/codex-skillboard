  "private": true,
  "description": "A local-first skill workbench for Codex: discover, recommend and select skills per conversation.",
  "license": "MIT",
  "author": "wangyufan253",
  "repository": { "type": "git", "url": "https://github.com/wangyufan253/codex-skillboard.git" },
